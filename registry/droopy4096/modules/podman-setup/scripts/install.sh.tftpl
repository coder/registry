#!/usr/bin/env bash
set -euo pipefail

NATIVE_OVERLAY="${ARG_NATIVE_OVERLAY}"
REQUIRED_TOOLS="${ARG_REQUIRED_TOOLS}"
DOCKER_SHIM="${ARG_DOCKER_SHIM}"

# This module configures what the image provides; it installs nothing. Check
# everything up front so one error lists every missing tool.
missing=()
for tool in podman $REQUIRED_TOOLS; do
  command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
done
if [ "$${#missing[@]}" -gt 0 ]; then
  echo "ERROR: required tools missing from the image: $${missing[*]}." >&2
  echo "Add them to the image, for example:" >&2
  echo "  Debian/Ubuntu: apt-get install -y $${missing[*]}" >&2
  echo "  Fedora/UBI:    dnf install -y $${missing[*]}" >&2
  echo "  Alpine:        apk add $${missing[*]}" >&2
  if ! command -v podman >/dev/null 2>&1; then
    echo "For rootless Podman, start from an image such as codercom/example-podman:ubuntu." >&2
  fi
  exit 1
fi

conf_dir="$${XDG_CONFIG_HOME:-$HOME/.config}/containers"
conf_file="$conf_dir/storage.conf"
marker="# Managed by the droopy4096/podman-setup Coder module."

if [ "$NATIVE_OVERLAY" = "true" ]; then
  if [ -f "$conf_file" ] && ! grep -qF "$marker" "$conf_file"; then
    echo "Leaving user-managed $conf_file alone."
  else
    mkdir -p "$conf_dir"
    # Images often pin fuse-overlayfs in /etc/containers/storage.conf; an empty
    # mount_program switches to kernel overlayfs (no /dev/fuse needed).
    cat > "$conf_file" <<CONF
$marker
[storage]
driver = "overlay"

[storage.options.overlay]
mount_program = ""
CONF
    echo "Configured native overlay storage in $conf_file."
  fi
fi

# Docker CLI compatibility. Without a docker command in the image, link one to
# Podman; an existing docker CLI is kept and uses DOCKER_HOST.
if [ "$DOCKER_SHIM" = "true" ]; then
  podman_bin="$(command -v podman)"
  docker_bin="$(command -v docker || true)"
  if [ -z "$docker_bin" ]; then
    if [ -w /usr/local/bin ]; then
      ln -sf "$podman_bin" /usr/local/bin/docker
      docker_bin=/usr/local/bin/docker
    elif sudo -n true 2>/dev/null; then
      sudo ln -sf "$podman_bin" /usr/local/bin/docker
      docker_bin=/usr/local/bin/docker
    else
      mkdir -p "$HOME/.local/bin"
      ln -sf "$podman_bin" "$HOME/.local/bin/docker"
      docker_bin="$HOME/.local/bin/docker"
      case ":$PATH:" in
        *":$HOME/.local/bin:"*) ;;
        *) echo "WARNING: $HOME/.local/bin is not on PATH; add it so 'docker' runs Podman." >&2 ;;
      esac
    fi
    echo "Linked $docker_bin -> $podman_bin."
  elif [ "$(readlink -f "$docker_bin")" = "$(readlink -f "$podman_bin")" ]; then
    echo "docker already runs Podman ($docker_bin)."
  else
    echo "Keeping the existing docker CLI at $docker_bin; it talks to Podman through DOCKER_HOST when socket = true."
  fi
  if [ "$(readlink -f "$docker_bin")" = "$(readlink -f "$podman_bin")" ] \
    && ! command -v docker-compose >/dev/null 2>&1 \
    && ! command -v podman-compose >/dev/null 2>&1; then
    echo "Note: 'docker compose' runs 'podman compose', which needs docker-compose or podman-compose in the image."
  fi
fi

podman info --format 'Podman {{.Version.Version}}: rootless={{.Host.Security.Rootless}} driver={{.Store.GraphDriverName}} graphroot={{.Store.GraphRoot}}'
# Report Buildah and Skopeo when the image has them, required or not.
for tool in buildah skopeo; do
  if command -v "$tool" >/dev/null 2>&1; then
    "$tool" --version
  fi
done
