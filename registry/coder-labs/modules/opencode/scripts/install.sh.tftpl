#!/usr/bin/env bash

set -euo pipefail

BOLD='\033[0;1m'

command_exists() {
  command -v "$1" > /dev/null 2>&1
}

ARG_INSTALL='${ARG_INSTALL}'
ARG_OPENCODE_VERSION='${ARG_OPENCODE_VERSION}'
ARG_WORKDIR=$(echo -n '${ARG_WORKDIR}' | base64 -d)
ARG_CONFIG_JSON=$(echo -n '${ARG_CONFIG_JSON}' | base64 -d)
ARG_MCP_CONFIG=$(echo -n '${ARG_MCP_CONFIG}' | base64 -d)

# Delivered through coder_env so credentials never appear in this script.
AUTH_JSON="$${CODER_OPENCODE_AUTH_JSON:-}"

OPENCODE_BIN_DIR="$HOME/.opencode/bin"
export PATH="$${OPENCODE_BIN_DIR}:$PATH"

# Same resolution order as `opencode debug paths config`.
OPENCODE_CONFIG_PATH="$${OPENCODE_CONFIG_DIR:-$${XDG_CONFIG_HOME:-$HOME/.config}/opencode}"

echo "--------------------------------"
printf "install_opencode: %s\n" "$${ARG_INSTALL}"
printf "opencode_version: %s\n" "$${ARG_OPENCODE_VERSION}"
printf "workdir: %s\n" "$${ARG_WORKDIR}"
printf "auth_json: %s\n" "$([ -n "$${AUTH_JSON}" ] && echo provided || echo "not provided")"
echo "--------------------------------"

require_jq() {
  if ! command_exists jq; then
    echo "ERROR: 'jq' is required to $1 but was not found." >&2
    exit 1
  fi
}

# Prints the JSON object stored in $1, or {} when the file is missing. Invalid
# files (for example JSONC with comments) are backed up to $1.bak.
read_json_object() {
  local file="$1"
  if [ ! -f "$${file}" ]; then
    echo '{}'
    return
  fi
  if jq -e 'type == "object"' "$${file}" > /dev/null 2>&1; then
    cat "$${file}"
    return
  fi
  cp "$${file}" "$${file}.bak"
  echo "Warning: $${file} is not a valid JSON object; backed it up to $${file}.bak" >&2
  echo '{}'
}

function add_path_to_shell_profiles() {
  local path_dir="$1"

  for profile in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.zprofile" "$HOME/.zshrc"; do
    if [ -f "$${profile}" ]; then
      if ! grep -q "$${path_dir}" "$${profile}" 2> /dev/null; then
        echo "export PATH=\"\$PATH:$${path_dir}\"" >> "$${profile}"
        echo "Added $${path_dir} to $${profile}"
      fi
    fi
  done

  local fish_config="$HOME/.config/fish/config.fish"
  if [ -f "$${fish_config}" ]; then
    if ! grep -q "$${path_dir}" "$${fish_config}" 2> /dev/null; then
      echo "fish_add_path $${path_dir}" >> "$${fish_config}"
      echo "Added $${path_dir} to $${fish_config}"
    fi
  fi
}

# Prints the bare version reported by `opencode --version` ("opencode v2.0.27" -> "2.0.27").
installed_opencode_version() {
  local out
  out=$(opencode --version 2> /dev/null) || return 1
  out="$${out##* }"
  echo "$${out#v}"
}

# V2 credentials and config shapes are not understood by OpenCode 1.
is_opencode_v1() {
  [[ "$1" =~ ^1\. ]]
}

function ensure_opencode_in_path() {
  local OPENCODE_BIN=""
  if command_exists opencode; then
    OPENCODE_BIN=$(command -v opencode)
  fi

  if [ -z "$${OPENCODE_BIN}" ] || [ ! -x "$${OPENCODE_BIN}" ]; then
    echo "OpenCode binary (opencode) was not found or is not executable." >&2
    return 1
  fi

  local OPENCODE_VERSION
  if ! OPENCODE_VERSION=$("$${OPENCODE_BIN}" --version); then
    echo "OpenCode binary could not be executed." >&2
    return 1
  fi
  printf "OpenCode version: %s\n" "$${OPENCODE_VERSION}"

  if is_opencode_v1 "$(installed_opencode_version)"; then
    echo "OpenCode 1 ($${OPENCODE_VERSION}) is not supported; this module requires OpenCode 2." >&2
    return 1
  fi

  if [ -n "$${CODER_SCRIPT_BIN_DIR:-}" ] && [ ! -e "$${CODER_SCRIPT_BIN_DIR}/opencode" ]; then
    ln -s "$${OPENCODE_BIN}" "$${CODER_SCRIPT_BIN_DIR}/opencode"
    echo "Created symlink: $${CODER_SCRIPT_BIN_DIR}/opencode -> $${OPENCODE_BIN}"
  fi

  add_path_to_shell_profiles "$(dirname "$${OPENCODE_BIN}")"
}

# Subshell scopes the temp-file cleanup trap to this function.
install_with_official_installer() (
  local installer_file
  installer_file=$(mktemp)
  trap 'rm -f "$${installer_file}"' EXIT

  if ! curl --fail --silent --show-error --location \
    --retry 2 --retry-delay 1 --retry-all-errors \
    --connect-timeout 10 --max-time 300 \
    --output "$${installer_file}" https://opencode.ai/v2/install; then
    echo "OpenCode installer could not be downloaded after up to 3 attempts." >&2
    return 1
  fi

  if ! bash -n "$${installer_file}"; then
    echo "OpenCode installer download was invalid." >&2
    return 1
  fi

  # The installer treats any non-empty VERSION as a release tag (a leading 'v'
  # is stripped), so 'latest' must be passed as empty. It installs to
  # ~/.opencode/bin; PATH is handled by this script.
  local version="$${ARG_OPENCODE_VERSION}"
  if [ "$${version}" = "latest" ]; then
    version=""
  fi
  # The installer resolves 'latest' through an update API that intermittently
  # fails, so retry the whole installer before giving up.
  local attempt
  for attempt in 1 2 3; do
    if VERSION="$${version}" bash "$${installer_file}" --no-modify-path; then
      return 0
    fi
    echo "OpenCode installer attempt $${attempt} failed." >&2
    sleep $((attempt * 2))
  done
  echo "OpenCode installation failed." >&2
  return 1
)

install_opencode() {
  if [ "$${ARG_INSTALL}" != "true" ]; then
    echo "Skipping OpenCode installation as per configuration."
    if ! ensure_opencode_in_path; then
      echo "ERROR: install_opencode is false but a working 'opencode' was not found on PATH." >&2
      exit 1
    fi
    printf "%s Validated existing OpenCode\n" "$${BOLD}"
    return
  fi

  if command_exists opencode; then
    local installed wanted
    installed=$(installed_opencode_version || true)
    wanted="$${ARG_OPENCODE_VERSION#v}"
    if is_opencode_v1 "$${installed}"; then
      echo "OpenCode $${installed} is installed; installing OpenCode 2"
    elif [ "$${ARG_OPENCODE_VERSION}" = "latest" ] || [ "$${installed}" = "$${wanted}" ]; then
      echo "OpenCode already installed ($${installed})"
      ensure_opencode_in_path
      return
    fi
    echo "OpenCode $${installed} is installed; installing $${wanted}"
  fi

  printf "%s Installing OpenCode\n" "$${BOLD}"
  install_with_official_installer

  if ! ensure_opencode_in_path; then
    echo "ERROR: Failed to install OpenCode" >&2
    exit 1
  fi
  printf "%s Installed OpenCode\n" "$${BOLD}"
}

setup_workdir() {
  if [ -n "$${ARG_WORKDIR}" ] && [ ! -d "$${ARG_WORKDIR}" ]; then
    echo "Creating workdir: $${ARG_WORKDIR}"
    mkdir -p "$${ARG_WORKDIR}"
  fi
}

# The module owns only the keys it sets; everything else in opencode.json is
# preserved. config_json keys win, while MCP servers already on disk win on
# duplicate names so in-workspace edits are not overwritten. V1 configs may
# still list servers directly under mcp, so those names count as existing too.
setup_config() {
  local config_file="$${OPENCODE_CONFIG_PATH}/opencode.json"

  if [ -z "$${ARG_CONFIG_JSON}" ] && [ -z "$${ARG_MCP_CONFIG}" ]; then
    echo "No config_json or mcp configured; leaving $${config_file} unchanged."
    return
  fi

  require_jq "configure OpenCode"

  mkdir -p "$(dirname "$${config_file}")"

  local existing config='{}' mcp='{}'
  existing=$(read_json_object "$${config_file}")
  if [ -n "$${ARG_CONFIG_JSON}" ]; then
    config="$${ARG_CONFIG_JSON}"
  fi
  if [ -n "$${ARG_MCP_CONFIG}" ]; then
    mcp="$${ARG_MCP_CONFIG}"
  fi

  echo "$${existing}" | jq --argjson config "$${config}" --argjson mcp "$${mcp}" '
    (. * $config)
    | if ($mcp | length) > 0 then
        ((.mcp // {}) | if type == "object" then . else {} end) as $current
        | ($current.servers // {}) as $servers
        | ($mcp | with_entries(select(
            .key as $name | (($servers | has($name)) or ($current | has($name))) | not
          ))) as $new
        | .mcp = ($current + {servers: ($servers + $new)})
      else . end
    | .["$schema"] //= "https://opencode.ai/config.json"
  ' > "$${config_file}.tmp"
  mv "$${config_file}.tmp" "$${config_file}"
  echo "OpenCode configuration written: $${config_file}"
}

# OpenCode 2 stores credentials in its SQLite database and ignores auth.json on
# fresh installs, so credentials go through `opencode auth import`. Import skips
# ids that already exist, so the module's own ids are logged out first to apply
# rotated secrets. --standalone avoids starting the shared background service.
setup_auth() {
  if [ -z "$${AUTH_JSON}" ]; then
    echo "No auth_json provided; leaving OpenCode credentials unchanged."
    return
  fi

  require_jq "import OpenCode credentials"

  if ! jq -e 'env.CODER_OPENCODE_AUTH_JSON | fromjson | type == "array"' -n > /dev/null 2>&1; then
    echo "ERROR: CODER_OPENCODE_AUTH_JSON is not a JSON array of credentials." >&2
    exit 1
  fi

  local existing_ids integration credential_id
  existing_ids=$(opencode auth export --standalone 2> /dev/null | jq -r '.[].id' 2> /dev/null || true)
  while IFS=$'\t' read -r integration credential_id; do
    if [ -n "$${credential_id}" ] && grep -qxF "$${credential_id}" <<< "$${existing_ids}"; then
      opencode auth logout --standalone "$${integration}" "$${credential_id}" < /dev/null > /dev/null 2>&1 || true
    fi
  done < <(jq -rn 'env.CODER_OPENCODE_AUTH_JSON | fromjson | .[] | [.integrationID, .id] | @tsv')

  # Read from the environment so credentials never appear in process arguments.
  if ! jq -n 'env.CODER_OPENCODE_AUTH_JSON | fromjson' | opencode auth import --standalone; then
    echo "ERROR: OpenCode credential import failed." >&2
    exit 1
  fi
  echo "OpenCode credentials imported."
}

# A running shared service caches configuration until it is reloaded.
reload_running_service() {
  local status
  status=$(opencode service status 2> /dev/null || true)
  if [[ "$${status}" == http* ]]; then
    if opencode reload > /dev/null 2>&1; then
      echo "Reloaded the running OpenCode service."
    else
      echo "Warning: could not reload the running OpenCode service; run 'opencode reload'." >&2
    fi
  fi
}

install_opencode
setup_workdir
setup_config
setup_auth
reload_running_service

echo "OpenCode module setup completed."
