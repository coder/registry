#!/usr/bin/env bash

set -euo pipefail

# module_directory is a constant set in main.tf, so double-quoting it to
# expand its literal "$HOME" at runtime is safe.
ARG_MODULE_DIRECTORY="${ARG_MODULE_DIRECTORY}"
ARG_PORT='${ARG_PORT}'
ARG_REDIRECT_PORT='${ARG_REDIRECT_PORT}'
ARG_APP_SLUG='${ARG_APP_SLUG}'
ARG_DASHBOARD_SLUG='${ARG_DASHBOARD_SLUG}'
ARG_WORKSPACE_NAME='${ARG_WORKSPACE_NAME}'
ARG_OWNER_NAME='${ARG_OWNER_NAME}'
ARG_ACCESS_SCHEME='${ARG_ACCESS_SCHEME}'
ARG_DASHBOARD_ORIGIN=$(echo -n '${ARG_DASHBOARD_ORIGIN}' | base64 -d)
ARG_FALLBACK_ORIGIN=$(echo -n '${ARG_FALLBACK_ORIGIN}' | base64 -d)
ARG_PROXY_HOSTNAMES=$(echo -n '${ARG_PROXY_HOSTNAMES}' | base64 -d)
ARG_EXTRA_ALLOWED_ORIGINS=$(echo -n '${ARG_EXTRA_ALLOWED_ORIGINS}' | base64 -d)

echo "--------------------------------"
printf "ARG_MODULE_DIRECTORY: %s\n" "$${ARG_MODULE_DIRECTORY}"
printf "ARG_PORT: %s\n" "$${ARG_PORT}"
printf "ARG_REDIRECT_PORT: %s\n" "$${ARG_REDIRECT_PORT}"
printf "ARG_APP_SLUG: %s\n" "$${ARG_APP_SLUG}"
printf "ARG_DASHBOARD_SLUG: %s\n" "$${ARG_DASHBOARD_SLUG}"
printf "ARG_WORKSPACE_NAME: %s\n" "$${ARG_WORKSPACE_NAME}"
printf "ARG_OWNER_NAME: %s\n" "$${ARG_OWNER_NAME}"
printf "ARG_ACCESS_SCHEME: %s\n" "$${ARG_ACCESS_SCHEME}"
printf "ARG_DASHBOARD_ORIGIN: %s\n" "$${ARG_DASHBOARD_ORIGIN}"
printf "ARG_FALLBACK_ORIGIN: %s\n" "$${ARG_FALLBACK_ORIGIN}"
printf "ARG_PROXY_HOSTNAMES: %s\n" "$${ARG_PROXY_HOSTNAMES//$'\n'/,}"
printf "ARG_EXTRA_ALLOWED_ORIGINS: %s\n" "$${ARG_EXTRA_ALLOWED_ORIGINS}"
# Runtime inputs from the agent that the dashboard origins are derived from.
printf "CODER_WORKSPACE_AGENT_NAME: %s\n" "$${CODER_WORKSPACE_AGENT_NAME:-}"
printf "VSCODE_PROXY_URI: %s\n" "$${VSCODE_PROXY_URI:-}"
echo "--------------------------------"

LOG_DIR="$${ARG_MODULE_DIRECTORY}/logs"
GATEWAY_LOG="$${LOG_DIR}/gateway.log"
REDIRECTOR_LOG="$${LOG_DIR}/redirector.log"
SCRIPTS_DIR="$${ARG_MODULE_DIRECTORY}/scripts"
LAUNCHER_PATH="$${SCRIPTS_DIR}/start-gateway.sh"
REDIRECTOR_PATH="$${SCRIPTS_DIR}/redirect-gateway.py"
ORIGINS_HELPER_PATH="$${SCRIPTS_DIR}/coder-origins.py"
ORIGINS_PATH="$${ARG_MODULE_DIRECTORY}/coder-origins.json"

mkdir -p "$${LOG_DIR}" "$${SCRIPTS_DIR}"
# Earlier versions wrote these into Kiro Crew's own data directory.
rm -f "$HOME/.kiro/crew/start-gateway.sh" "$HOME/.kiro/crew/redirect-gateway.py"
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Everything below is best effort and must reach the launch step, so disable
# errexit for the remainder of the script.
set +e

# Stops whatever listens on a port. Never match by process name: the agent
# runs scripts with their full text in argv, so a pattern such as "kirocrew"
# would also match, and terminate, this script.
free_port() {
  local port="$1"
  if command -v fuser > /dev/null 2>&1; then
    fuser -k "$${port}/tcp" > /dev/null 2>&1 || true
  else
    local port_pid
    port_pid="$(ss -ltnHp "sport = :$${port}" 2> /dev/null | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)"
    if [ -n "$${port_pid}" ] && [ "$${port_pid}" != "$$" ] && [ "$${port_pid}" != "$PPID" ]; then
      kill "$${port_pid}" > /dev/null 2>&1 || true
    fi
  fi
}

KIROCREW_CMD=""
if command -v kirocrew > /dev/null 2>&1; then
  KIROCREW_CMD="$(command -v kirocrew)"
elif [ -x "$HOME/.kiro/crew-venv/bin/kirocrew" ]; then
  KIROCREW_CMD="$HOME/.kiro/crew-venv/bin/kirocrew"
else
  echo "ERROR: kirocrew binary not found. Check the install log in $${LOG_DIR}/install.log." >&2
  exit 1
fi

free_port "$${ARG_PORT}"
free_port "$${ARG_REDIRECT_PORT}"

echo "Using kirocrew binary: $${KIROCREW_CMD}"
echo "Gateway port: $${ARG_PORT}"
echo "Gateway log: $${GATEWAY_LOG}"

# Run the loopback redirector with the Python the Kiro Crew installer
# provisions (a managed CPython under ~/.kiro/crew-python, or a managed/pipx
# venv depending on the installer version), falling back to system python3
# only if none is found, so the module does not depend on a system Python.
PYTHON_BIN="python3"
for candidate in \
  "$HOME/.kiro/crew-venv/bin/python" \
  "$HOME"/.kiro/crew-python/*/bin/python3 \
  "$HOME/.local/share/pipx/venvs/kirocrew/bin/python"; do
  if [ -x "$${candidate}" ]; then
    PYTHON_BIN="$${candidate}"
    break
  fi
done
echo "Redirector Python: $${PYTHON_BIN}"

# Coder serves subdomain apps at <wildcard> with "*" replaced by
# <slug>--<workspace>--<owner>, on the primary deployment and on every
# workspace proxy, each with its own wildcard hostname. The gateway only
# accepts Host/Origin values from an exact allowlist that is fixed at launch,
# so this helper expands every known wildcard into exact origins once and
# writes one snapshot. The gateway allowlist and the redirector routes both
# come from that snapshot, so the redirector never sends a token to an origin
# the gateway rejects or to a host taken from the request.
cat > "$${ORIGINS_HELPER_PATH}" << 'PYEOF'
import json
import os
import sys
from urllib.parse import urlsplit

env = os.environ
app_slug = env["KC_APP_SLUG"]
dash_slug = env["KC_DASHBOARD_SLUG"]
workspace = env["KC_WORKSPACE_NAME"]
owner = env["KC_OWNER_NAME"]
agent = env.get("CODER_WORKSPACE_AGENT_NAME", "")
access_scheme = env.get("KC_ACCESS_SCHEME", "https")
override = env.get("KC_DASHBOARD_ORIGIN", "").strip().rstrip("/")
fallback = env.get("KC_FALLBACK_ORIGIN", "").strip().rstrip("/")
proxy_uri = env.get("VSCODE_PROXY_URI", "").strip()


def log(msg):
    print(msg, file=sys.stderr)


def split_wildcard(value, default_scheme):
    """Returns (scheme, host-pattern) for a wildcard such as '*.apps.example.com'."""
    value = value.strip().rstrip("/")
    scheme = default_scheme
    for prefix in ("https://", "http://"):
        if value.lower().startswith(prefix):
            scheme = prefix[:-3]
            value = value[len(prefix):]
    first_label = value.split(".", 1)[0]
    if not value or "/" in value or value.count("*") != 1 or "*" not in first_label:
        return None
    return scheme, value.lower()


def primary_wildcard():
    """Recovers the primary wildcard hostname from VSCODE_PROXY_URI.

    Coder sets it to <scheme>://<wildcard> with "*" replaced by
    "{{port}}--<agent>--<workspace>--<owner>".
    """
    if not proxy_uri:
        return None
    marker = "{{port}}--%s--%s--%s" % (agent, workspace, owner)
    parts = urlsplit(proxy_uri)
    host = parts.netloc
    idx = host.lower().find(marker.lower()) if agent else -1
    if parts.scheme not in ("http", "https") or idx < 0:
        log("WARNING: VSCODE_PROXY_URI has an unexpected format: %s" % proxy_uri)
        return None
    return split_wildcard(
        "%s://%s*%s" % (parts.scheme, host[:idx], host[idx + len(marker):]),
        parts.scheme,
    )


def expand(wildcard, subdomain):
    scheme, pattern = wildcard
    return scheme, pattern.replace("*", subdomain.lower(), 1)


wildcards = []
primary_from_proxy_uri = None
if not override:
    primary_from_proxy_uri = primary_wildcard()
    if primary_from_proxy_uri:
        wildcards.append(primary_from_proxy_uri)
for line in env.get("KC_PROXY_HOSTNAMES", "").splitlines():
    if not line.strip():
        continue
    parsed = split_wildcard(line, access_scheme)
    if parsed is None:
        log("WARNING: ignoring invalid workspace proxy hostname: %s" % line)
    elif parsed not in wildcards:
        wildcards.append(parsed)

# Coder omits the agent from slug app subdomains, but also routes the form
# that names the agent, so both are trusted.
suffixes = ["--%s--%s" % (workspace, owner)]
if agent:
    suffixes.append("--%s--%s--%s" % (agent, workspace, owner))

routes = {}
for wildcard in wildcards:
    for suffix in suffixes:
        _, app_host = expand(wildcard, app_slug + suffix)
        scheme, dash_host = expand(wildcard, dash_slug + suffix)
        routes[app_host] = "%s://%s" % (scheme, dash_host)

if override:
    primary = override
elif wildcards:
    scheme, dash_host = expand(wildcards[0], dash_slug + suffixes[0])
    primary = "%s://%s" % (scheme, dash_host)
    if primary_from_proxy_uri is None:
        log("WARNING: VSCODE_PROXY_URI is not set; using the first workspace proxy as the primary dashboard origin.")
else:
    primary = fallback
    log("WARNING: could not determine the wildcard app hostname; assuming %s. Set dashboard_origin if the dashboard is unreachable." % fallback)

allowed = [primary]
for origin in list(routes.values()) + env.get("KC_EXTRA_ALLOWED_ORIGINS", "").split(","):
    origin = origin.strip().rstrip("/")
    if origin and origin not in allowed:
        allowed.append(origin)

with open(sys.argv[1], "w") as f:
    json.dump({"primary": primary, "routes": routes, "allowed_origins": allowed}, f, indent=2)
print(primary)
print(",".join(allowed))
PYEOF

DASHBOARD_URL=""
ALLOWED_ORIGINS=""
{
  read -r DASHBOARD_URL
  read -r ALLOWED_ORIGINS
} < <(
  KC_APP_SLUG="$${ARG_APP_SLUG}" \
    KC_DASHBOARD_SLUG="$${ARG_DASHBOARD_SLUG}" \
    KC_WORKSPACE_NAME="$${ARG_WORKSPACE_NAME}" \
    KC_OWNER_NAME="$${ARG_OWNER_NAME}" \
    KC_ACCESS_SCHEME="$${ARG_ACCESS_SCHEME}" \
    KC_DASHBOARD_ORIGIN="$${ARG_DASHBOARD_ORIGIN}" \
    KC_FALLBACK_ORIGIN="$${ARG_FALLBACK_ORIGIN}" \
    KC_PROXY_HOSTNAMES="$${ARG_PROXY_HOSTNAMES}" \
    KC_EXTRA_ALLOWED_ORIGINS="$${ARG_EXTRA_ALLOWED_ORIGINS}" \
    "$${PYTHON_BIN}" "$${ORIGINS_HELPER_PATH}" "$${ORIGINS_PATH}"
)
if [ -z "$${DASHBOARD_URL}" ]; then
  echo "ERROR: could not compute the Kiro Crew dashboard origins." >&2
  exit 1
fi
echo "Primary dashboard origin: $${DASHBOARD_URL}"
echo "Gateway allowed origins: $${ALLOWED_ORIGINS}"

if [ -n "$${KIRO_API_KEY:-}" ]; then
  echo "Headless Kiro auth: KIRO_API_KEY detected; kiro-cli authenticates non-interactively."
else
  echo "Headless Kiro auth: KIRO_API_KEY not set; sign in with 'kiro-cli login', or create a Coder user secret that sets KIRO_API_KEY."
fi

# The launcher is written with a quoted heredoc so nothing expands at write
# time. Values reach it through the environment at launch.
#
# Kiro Crew sandboxes agent subprocesses with a Linux user namespace. Many
# Kubernetes pods set user.max_user_namespaces=0, so when unshare fails the
# launcher allows unsandboxed exec and the pod is the isolation boundary.
cat > "$${LAUNCHER_PATH}" << 'LAUNCHER'
#!/usr/bin/env bash
# Trust the Coder proxy origins in the gateway's Host/Origin allowlist.
[ -n "$KC_ORIGINS" ] && export KIROCREW_CORS_ORIGINS="$KC_ORIGINS"
# Scope token cookies to the dashboard app's public origin.
[ -n "$KC_DASHBOARD_URL" ] && "$KC_CMD" config set dashboard.url "$KC_DASHBOARD_URL" > /dev/null 2>&1 || true
if ! unshare --user --map-root-user true > /dev/null 2>&1; then
  "$KC_CMD" config set agent.sandbox_allow_unsandboxed_exec true > /dev/null 2>&1 || true
fi
exec env KIROCREW_PORT="$KC_PORT" "$KC_CMD" gateway
LAUNCHER
chmod +x "$${LAUNCHER_PATH}"

# The gateway can take a while to cold start, and the agent terminates start
# scripts that run too long, so the gateway runs in a detached session and
# readiness is reported by the dashboard app healthcheck.
: > "$${GATEWAY_LOG}" 2> /dev/null || true
setsid nohup env \
  KC_CMD="$${KIROCREW_CMD}" \
  KC_PORT="$${ARG_PORT}" \
  KC_ORIGINS="$${ALLOWED_ORIGINS}" \
  KC_DASHBOARD_URL="$${DASHBOARD_URL}" \
  bash "$${LAUNCHER_PATH}" >> "$${GATEWAY_LOG}" 2>&1 < /dev/null &
disown 2> /dev/null || true
echo "Kiro Crew gateway launch dispatched."

# The visible app tile points at this loopback redirector. Each request mints
# a short-lived token from the gateway's loopback secret and redirects to the
# dashboard app with ?token=. Coder forwards the browser's Host, which selects
# the dashboard origin on the same primary or proxy hostname. Unknown hosts go
# to the primary origin. /healthz answers without minting a token so the app
# healthcheck does not create tokens.
cat > "$${REDIRECTOR_PATH}" << 'PYEOF'
import http.server
import json
import os
import urllib.request

REDIR_PORT = int(os.environ["REDIR_PORT"])
GW_BASE = "http://127.0.0.1:" + os.environ["GW_PORT"]
with open(os.environ["ORIGINS_PATH"]) as f:
    ORIGINS = json.load(f)
PRIMARY = ORIGINS["primary"].rstrip("/")
ROUTES = ORIGINS["routes"]
SECRET = os.path.expanduser("~/.kiro/crew/.local_secret")


class Handler(http.server.BaseHTTPRequestHandler):
    def _mint(self):
        with open(SECRET) as f:
            secret = f.read().strip()
        req = urllib.request.Request(
            GW_BASE + "/api/token/local?ttl=24h",
            headers={"X-Local-Secret": secret},
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            return json.load(resp).get("token", "")

    def _dashboard_origin(self):
        host = (self.headers.get("Host") or "").strip().lower().rstrip(".")
        return ROUTES.get(host, PRIMARY).rstrip("/")

    def do_GET(self):
        if self.path.startswith("/healthz"):
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"ok")
            return
        try:
            token = self._mint()
        except Exception:
            token = ""
        if not token:
            self.send_response(503)
            self.end_headers()
            self.wfile.write(b"Kiro Crew gateway still starting - retry shortly")
            return
        self.send_response(302)
        self.send_header("Location", self._dashboard_origin() + "/?token=" + token)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.end_headers()

    def log_message(self, *args):
        pass


http.server.HTTPServer(("127.0.0.1", REDIR_PORT), Handler).serve_forever()
PYEOF

: > "$${REDIRECTOR_LOG}" 2> /dev/null || true
setsid nohup env \
  REDIR_PORT="$${ARG_REDIRECT_PORT}" \
  GW_PORT="$${ARG_PORT}" \
  ORIGINS_PATH="$${ORIGINS_PATH}" \
  "$${PYTHON_BIN}" "$${REDIRECTOR_PATH}" >> "$${REDIRECTOR_LOG}" 2>&1 < /dev/null &
disown 2> /dev/null || true
echo "Kiro Crew redirector dispatched on port $${ARG_REDIRECT_PORT} -> $${DASHBOARD_URL}"

exit 0
