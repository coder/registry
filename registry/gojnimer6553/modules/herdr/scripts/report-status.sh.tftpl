#!/usr/bin/env bash
# Reports whether any agent Herdr tracks is working to a Coder app.
# Usage: report-status.sh <app-slug>
#
# Coder treats a "working" report as workspace activity and extends the
# autostop deadline, so a workspace stays up while agents in Herdr work even
# with no IDE, SSH, or web terminal connection open.

set -u

slug="$1"
interval=30
# Resend "working" at most every 5 minutes, which is far below the smallest
# useful activity bump, and send "idle" only on change.
resend_after=300

export PATH="$HOME/.local/bin:$PATH"

report() {
  local state="$1" message="$2"
  curl --fail --silent --show-error --max-time 10 --output /dev/null \
    -X PATCH "$${CODER_AGENT_URL%/}/api/v2/workspaceagents/me/app-status" \
    -H "Coder-Session-Token: $${CODER_AGENT_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "$(printf '{"app_slug":"%s","state":"%s","message":"%s"}' "$${slug}" "$${state}" "$${message}")"
}

last_state=""
last_sent=0
while true; do
  # `herdr agent list` prints one JSON document. Count agents in the
  # "working" state without requiring jq in the workspace image.
  working=$(herdr agent list 2> /dev/null | grep -o '"agent_status":"working"' | wc -l | tr -d ' ')
  if [ "$${working:-0}" -gt 0 ]; then
    state="working"
    message="$${working} agent(s) working in Herdr"
  else
    state="idle"
    message="No agents working in Herdr"
  fi

  now=$(date +%s)
  if [ "$${state}" != "$${last_state}" ] || { [ "$${state}" = "working" ] && [ $((now - last_sent)) -ge "$${resend_after}" ]; }; then
    if report "$${state}" "$${message}"; then
      last_state="$${state}"
      last_sent="$${now}"
    fi
  fi
  sleep "$${interval}"
done
