#!/usr/bin/env bash
# Stops every worker process a previous agent start left behind. Runs as
# the coder-utils pre-install step. The home directory, and with it the
# detached processes' records, can outlive the agent, so a new start must
# never run beside an old worker.
#
# The supervisor and the worker each publish "<pid> <boot id> <starttime>"
# in their own file, under supervisors/ and workers/, before the worker CLI
# runs. The worker records itself, so it stays tracked even when its
# supervisor is SIGKILLed. A pid alone can be reused after a reboot or once
# the process exits, so a process is only signalled while the boot id and
# the /proc starttime still match. A record is removed only once the process
# it identifies is verified gone.
#
# coder-utils marks the pre-install step complete even when it fails, so
# the install and start steps run regardless. The cleanup-complete marker
# is the barrier instead: removed before anything else, and written, with a
# fresh id, only once every old process is gone. The start step refuses to
# launch without it, and the supervisor and worker exit before running
# anything if the marker no longer holds the id they were launched with,
# which closes the window between launch and publishing a record.
set -euo pipefail

cleanup_marker="${module_directory}/cleanup-complete"
rm -f "$cleanup_marker" "$cleanup_marker.tmp"

state_file="${state_file}"
token_file="${module_directory}/worker-token"
record_dirs=("${module_directory}/supervisors" "${module_directory}/workers")
mkdir -p "$${record_dirs[@]}" "$(dirname "$state_file")"

# Without the boot id no record can be verified, and dropping records it
# cannot verify would leave a live worker untracked.
if ! boot_id="$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)" || [ -z "$boot_id" ]; then
	echo "Cannot read /proc/sys/kernel/random/boot_id; cannot verify previous Cursor worker processes." >&2
	exit 1
fi

# Prints the starttime of a live, non-zombie pid. comm, field 2 of
# /proc/<pid>/stat, may contain spaces and parentheses, so everything up to
# the last ") " is dropped; starttime, field 22, is then field 20.
process_starttime() {
	local stat
	stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
	stat="$${stat##*) }"
	# shellcheck disable=SC2086 # Word splitting into fields is the point.
	set -- $stat
	[ "$1" != "Z" ] || return 1
	printf '%s' "$${20:-}"
}

# True when pid is still the live process that started at starttime.
identity_alive() {
	[ "$(process_starttime "$1" || true)" = "$2" ]
}

# The previous run's state must never be reported as this run's.
rm -f "$state_file" "$state_file.tmp"

# Entries are "<pid> <starttime> <kind> <record>".
pending=()
for dir in "$${record_dirs[@]}"; do
	kind="$(basename "$dir")"
	kind="$${kind%s}"
	for record in "$dir"/*; do
		[ -f "$record" ] || continue
		pid="" recorded_boot="" recorded_start=""
		read -r pid recorded_boot recorded_start <"$record" || true
		if [[ "$pid" =~ ^[0-9]+$ && "$recorded_start" =~ ^[0-9]+$ ]] &&
			[ "$recorded_boot" = "$boot_id" ] &&
			identity_alive "$pid" "$recorded_start"; then
			pending+=("$pid $recorded_start $kind $record")
		else
			rm -f "$record"
		fi
	done
	# A temp file left by a process that died mid-write identifies nothing.
	# Removing one that is mid-write makes that process exit without
	# running the worker.
	rm -f "$dir"/.*.tmp
done

# Signals every pending process that is still the one its record names.
signal_pending() {
	local entry pid start kind record
	for entry in "$${pending[@]+"$${pending[@]}"}"; do
		read -r pid start kind record <<<"$entry"
		if identity_alive "$pid" "$start"; then
			kill "-$1" "$pid" 2>/dev/null || true
		fi
	done
}

# Waits up to $1 tenths of a second for every pending process to exit,
# removing each record once its process is verified gone. Fails if any
# process remains.
wait_pending() {
	local i entry pid start kind record remaining
	for ((i = 0; ; i++)); do
		remaining=()
		for entry in "$${pending[@]+"$${pending[@]}"}"; do
			read -r pid start kind record <<<"$entry"
			if identity_alive "$pid" "$start"; then
				remaining+=("$entry")
			else
				rm -f "$record"
			fi
		done
		pending=("$${remaining[@]+"$${remaining[@]}"}")
		[ "$${#pending[@]}" -eq 0 ] && return 0
		[ "$i" -lt "$1" ] || return 1
		sleep 0.1
	done
}

if [ "$${#pending[@]}" -gt 0 ]; then
	for entry in "$${pending[@]}"; do
		read -r pid _ kind _ <<<"$entry"
		echo "Stopping previous Cursor $kind (pid $pid)."
	done
	# Bounded: a worker that ignores TERM must not hang the agent.
	signal_pending TERM
	if ! wait_pending 100; then
		for entry in "$${pending[@]}"; do
			read -r pid _ kind _ <<<"$entry"
			echo "Previous Cursor $kind (pid $pid) did not stop within 10s; sending SIGKILL."
		done
		signal_pending KILL
		if ! wait_pending 50; then
			# The records stay, so the next cleanup retries these processes.
			for entry in "$${pending[@]}"; do
				read -r pid _ kind _ <<<"$entry"
				echo "Previous Cursor $kind (pid $pid) survived SIGKILL." >&2
			done
			exit 1
		fi
	fi
fi

# A supervisor may have written state while TERM was in flight. With every
# old process gone, nothing can use the token or rewrite the state.
rm -f "$state_file" "$state_file.tmp" "$token_file" "$token_file.tmp"
# Old start claims are safe to remove only after their processes have gone.
for claim in "${module_directory}/started"/*; do
	if [ -d "$claim" ]; then rmdir "$claim"; fi
done
cat /proc/sys/kernel/random/uuid >"$cleanup_marker.tmp"
mv "$cleanup_marker.tmp" "$cleanup_marker"
