#!/usr/bin/env bash
# Rendered into the agent_relay_session_attached agent metadata item (see
# README). Prints one line that Agent Relay reads to decide whether to keep
# the workspace's autostop deadline moving:
#
#   attached    the runner is running and holds a session, including
#               between turns
#   unattached  the runner is running and holds no session
#   stopped     the runner is not running: it exited, died, never started,
#               or the workspace was created manually
#   disabled    health_port is 0, so attachment cannot be observed
#
# When the runner is running but its listener cannot be read, the script
# exits non-zero instead. The sample is then an error, which the relay
# treats as unknown rather than as any of the values above.
#
# Running means the pid the supervisor recorded is alive and is still the
# CLI it launched. The supervisor writes "working <pid>" after it starts
# the runner and replaces it with "done <code>" when the runner exits.
set -euo pipefail

state_file="${state_file}"
health_url="${health_url}"

if [ -z "$health_url" ]; then
	echo "disabled"
	exit 0
fi

# kill -0 alone would trust a reused pid; the cmdline check ties it to the
# CLI the supervisor launched.
runner_alive() {
	[ -n "$${1:-}" ] && kill -0 "$1" 2>/dev/null &&
		tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -qF -- "$(basename "${cli_binary}")"
}

state=""
detail=""
if [ -f "$state_file" ]; then
	read -r state detail <"$state_file" || true
fi
if [ "$state" != "working" ] || ! runner_alive "$detail"; then
	echo "stopped"
	exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
	echo "curl is required to read $health_url/healthz" >&2
	exit 1
fi

# The listener starts once the runner registers, so a fresh runner fails
# here briefly. That reads as unknown, which is correct.
if ! body="$(curl -fsS --max-time 3 "$health_url/healthz")"; then
	echo "cannot read $health_url/healthz" >&2
	exit 1
fi

active="$(printf '%s' "$body" | grep -oE '"active_sessions"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$' || true)"
if [ -z "$active" ]; then
	echo "$health_url/healthz has no numeric active_sessions" >&2
	exit 1
fi

if [ "$active" -gt 0 ]; then
	echo "attached"
else
	echo "unattached"
fi
