#!/usr/bin/env bash
# Install step, run by coder-utils before the start step. Makes sure the
# Claude Code CLI is on PATH; a CLI already in the image makes this a
# no-op, so a prepared image spends none of the claim-to-ready window
# here. Never fails the build: the start step owns the terminal state a
# missing binary produces, so Agent Relay sees one vocabulary.
set -euo pipefail

%{ if install_cli ~}
# The installer places the binary under ~/.local/bin, so that directory
# joins PATH for the presence check.
export PATH="$HOME/.local/bin:$PATH"
if command -v ${cli_binary} >/dev/null 2>&1; then
	echo "Claude Code CLI already present; skipping the install."
else
	echo "Claude Code CLI not found; installing the latest release..."
	# -L is required: claude.ai/install.sh redirects to downloads.claude.ai,
	# and without it curl exits 0 having written nothing, so the pipe to
	# bash succeeds and installs nothing.
	if ! curl https://claude.ai/install.sh -fsSL | bash; then
		echo "Claude Code CLI install failed." >&2
	fi
fi
%{ else ~}
echo "install_cli is false; expecting '${cli_binary}' to be in the image."
%{ endif ~}
