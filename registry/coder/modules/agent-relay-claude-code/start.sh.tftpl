#!/usr/bin/env bash
# Start step, run by coder-utils after the install step. Runs at agent
# start with SELF_HOSTED_RUNNER_ENVIRONMENT_SECRET (the work-order JWT),
# SELF_HOSTED_RUNNER_LOCK_TO_ACCOUNT, and
# AGENT_RELAY_CLAUDE_CODE_RELEASE_IDLE_SESSION_MIN in scope.
#
# Starts the runner detached and exits, so the agent reaches the ready
# lifecycle state instead of sitting in starting for the life of the
# session. The detached supervisor records the runner's lifecycle to
# ${state_file}, which the agent_relay_status agent metadata item publishes for
# Agent Relay. See README.
set -euo pipefail

state_file="${state_file}"
log_file="${log_file}"
base_dir="${base_dir}"
supervisors="${module_directory}/supervisors"
workers="${module_directory}/workers"
cleanup_marker="${module_directory}/cleanup-complete"
mkdir -p "${module_directory}"
publish_generation() {
	generation=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || true)
	if [ -z "$generation" ]; then
		generation="$$-$RANDOM-$(date +%s%N)"
	fi
	printf '%s\n' "$generation" >"$cleanup_marker.tmp"
	mv "$cleanup_marker.tmp" "$cleanup_marker"
}
if [ ! -s "$cleanup_marker" ]; then
	echo "Startup cleanup did not finish; starting a runner anyway" >&2
	publish_generation
else
	generation=$(< "$cleanup_marker")
fi
# One argument per line. Shell-quoted here because the string is expanded
# into the supervisor below, which must see each argument as one word.
additional_args=""
while IFS= read -r arg || [ -n "$arg" ]; do
	if [ -n "$arg" ]; then
		additional_args+="$(printf '%q' "$arg") "
	fi
done < <(echo -n '${additional_args}' | base64 -d)
state_dir="$(dirname "$state_file")"
mkdir -p "$state_dir" "$(dirname "$log_file")" "$base_dir" "$supervisors" "$workers"

write_state() {
	# Write via a temp file so a reader never sees a partial line.
	printf '%s\n' "$1" >"$state_file.tmp"
	mv "$state_file.tmp" "$state_file"
}

if [ -z "$${SELF_HOSTED_RUNNER_ENVIRONMENT_SECRET:-}" ]; then
	write_state "idle"
	echo "No work order set. No runner will start on this agent start."
	echo "Idling. A new work order is required to start another runner."
	exit 0
fi

# A completed pre-install normally gives each start a fresh generation.
# If that step was skipped, a previous start may already have claimed this
# marker. Rotate it and launch anyway rather than strand the new work order.
mkdir -p "${module_directory}/started"
if ! mkdir "${module_directory}/started/$generation" 2>/dev/null; then
	echo "Runner already started for this cleanup generation; starting a new generation anyway" >&2
	publish_generation
	mkdir -p "${module_directory}/started/$generation"
fi
write_state "pending"

# ~/.local/bin is where the official installer puts the CLI, whether the
# install step ran it or the image author did. Unconditional so a
# bring-your-own CLI there is found when install_cli is false; harmless
# when the directory does not exist.
export PATH="$HOME/.local/bin:$PATH"

# A missing binary is a template problem, so it is reported as a
# terminal state for Agent Relay to nack rather than started blind,
# which would loop as "done 127". Bake the CLI into the image, or set
# install_cli to download it on start.
if ! command -v ${cli_binary} >/dev/null 2>&1; then
	write_state "failed runner-agent-missing"
	echo "The runner binary '${cli_binary}' is not available." >&2
	echo "Bake the Claude Code CLI into the image, set install_cli = true, or set cli_binary. See the module README." >&2
	exit 1
fi

# The parameter is validated when the workspace builds; checked again here
# because the value is read from the environment and used in arithmetic.
# Normalized to plain decimal so a leading zero or + is not misread later.
# Unset falls back to the module's release_idle_session_min.
release_idle_session_min="$${AGENT_RELAY_CLAUDE_CODE_RELEASE_IDLE_SESSION_MIN:-${release_idle_session_min}}"
if [[ ! "$release_idle_session_min" =~ ^[+]?0*[0-9]{1,5}$ ]] ||
	[ "$((10#$${release_idle_session_min#+}))" -gt 10080 ]; then
	write_state "failed invalid-release-idle-session-min"
	echo "Idle session release must be a whole number of minutes from 0 to 10080, got '$release_idle_session_min'." >&2
	exit 1
fi
export AGENT_RELAY_CLAUDE_CODE_RELEASE_IDLE_SESSION_MIN="$((10#$${release_idle_session_min#+}))"

# Write a wrapper that forces bypassPermissions so sessions never stall
# on a tool-approval prompt. There is no terminal attached to the child
# claude process, so an approval prompt would hang the runner.
#
# The CLI refuses bypassPermissions as root unless IS_SANDBOX=1, and a
# workspace agent often runs as root. Without it every session would die
# on start while the state file still said working, so the relay would
# keep feeding the workspace. The runner workspace is an ephemeral
# container with nothing else in it, which is the sandbox the flag asks
# about. Set on the wrapper alone so only the session child sees it.
#
# Kept beside the supervisor, not under ~/.claude: that is the runner's
# host config dir, which it snapshots into every session's
# CLAUDE_CONFIG_DIR, so a wrapper there would be copied into each session.
wrapper="$state_dir/wrapper.sh"
cat >"$wrapper" <<'WRAPPER'
#!/usr/bin/env bash
export IS_SANDBOX=1
exec "$CLAUDE_RUNNER_CLAUDE_BIN" "$@" --permission-mode bypassPermissions
WRAPPER
chmod +x "$wrapper"

# The runner wrapper publishes the child's identity before it can execute
# the CLI. If cleanup won the race with a late launch, its generation has
# changed and the wrapper exits without starting a runner.
runner_wrapper="$state_dir/run-runner.sh"
cat >"$runner_wrapper.$$.tmp" <<RUNNER
#!/usr/bin/env bash
set -euo pipefail
expected_generation="\$1"
shift
boot_id=\$(< /proc/sys/kernel/random/boot_id)
IFS= read -r stat <"/proc/\$\$/stat"
stat=\$${stat##*) }
# shellcheck disable=SC2086 # Split /proc fields.
set -- \$stat
[ -n "\$boot_id" ] && [[ "\$${20:-}" =~ ^[0-9]+$ ]] || exit 1
record="$workers/\$\$-\$boot_id-\$${20}"
printf '%s %s %s\n' "\$\$" "\$boot_id" "\$${20}" >"\$record.tmp" &&
	mv "\$record.tmp" "\$record" || exit 1
if [ "\$(cat "$cleanup_marker" 2>/dev/null || true)" != "\$expected_generation" ]; then
	rm -f "\$record"
	exit 0
fi
export PATH="\$HOME/.local/bin:\$PATH"
# Read from the environment at run time, never rendered into this file.
# 0 omits the flag, which leaves the CLI's default of never releasing.
if [ "\$AGENT_RELAY_CLAUDE_CODE_RELEASE_IDLE_SESSION_MIN" -gt 0 ]; then
	set -- --release-idle-session-min "\$AGENT_RELAY_CLAUDE_CODE_RELEASE_IDLE_SESSION_MIN"
fi
# Keep these flags in sync with the reserved-flag list in additional_args'
# validation in main.tf, so additional_args cannot set them a second time.
exec ${cli_binary} self-hosted-runner \\
	--capacity 1 \\
	--base-dir "$base_dir" \\
%{ if exit_if_unused_min > 0 ~}
	--exit-if-unused-min ${exit_if_unused_min} \\
%{ endif ~}
	"\$@" \\
	--health-port ${health_port} \\
	$additional_args \\
	--exec-path "$wrapper"
RUNNER
chmod +x "$runner_wrapper.$$.tmp"
mv "$runner_wrapper.$$.tmp" "$runner_wrapper"

# The supervisor outlives this script: it owns the runner process and is
# the only writer of terminal state. Written to disk rather than inlined
# so setsid gets a clean argv.
supervisor="$state_dir/supervise.sh"
cat >"$supervisor.$$.tmp" <<SUPERVISOR
#!/usr/bin/env bash
set -uo pipefail

generation="\$1"
if [ "\$(cat "$cleanup_marker" 2>/dev/null || true)" != "\$generation" ]; then exit 0; fi
supervisors="$supervisors"
boot_id=\$(< /proc/sys/kernel/random/boot_id)
IFS= read -r stat <"/proc/\$\$/stat"
stat=\$${stat##*) }
# shellcheck disable=SC2086 # Split /proc fields.
set -- \$stat
[ -n "\$boot_id" ] && [[ "\$${20:-}" =~ ^[0-9]+$ ]] || exit 1
record="\$supervisors/\$\$-\$boot_id-\$${20}"
printf '%s %s %s\n' "\$\$" "\$boot_id" "\$${20}" >"\$record.tmp" &&
	mv "\$record.tmp" "\$record" || exit 1
stopping=false
cleanup() {
	rm -f "\$record.tmp" "\$record"
}
stop() {
	stopping=true
	local target="\$${!:-}"
	if [ -n "\$target" ]; then
		kill -TERM "\$target" 2>/dev/null || true
		wait "\$target" 2>/dev/null || true
		rm -f "$workers/\$target-"*
	fi
	exit 0
}
trap cleanup EXIT
trap stop TERM

write_state() {
	[ "\$(cat "$cleanup_marker" 2>/dev/null || true)" = "\$generation" ] || return 0
	printf '%s\n' "\$1" >"$state_file.tmp"
	mv "$state_file.tmp" "$state_file"
}

"$runner_wrapper" "\$generation" >"$log_file" 2>&1 &
runner_pid=\$!
write_state "working \$runner_pid"

wait "\$runner_pid"
code=\$?
rm -f "$workers/\$runner_pid-"*
if [ "\$stopping" = false ]; then
	write_state "done \$code"
fi
SUPERVISOR
chmod +x "$supervisor.$$.tmp"
mv "$supervisor.$$.tmp" "$supervisor"

echo "Starting Claude Code self-hosted runner (detached)..."
setsid nohup "$supervisor" "$generation" >/dev/null 2>&1 </dev/null &

# Give the supervisor a moment to record state, so a workspace that
# fails immediately is visible as such rather than as pending. Not a
# readiness gate: the runner registering with Anthropic and picking up
# the session both happen later, and blocking on them would keep the
# agent out of the ready state.
state=""
for ((i = 0; i < 50; i++)); do
	state="$(cat "$state_file" 2>/dev/null || true)"
	case "$state" in "" | pending) sleep 0.2 ;; *) break ;; esac
done

case "$state" in
"" | pending) echo "Runner did not report state within 10s; check $log_file" >&2 ;;
*) echo "Runner state: $state" ;;
esac
echo "Runner log: $log_file"
