#!/usr/bin/env bash
# Run before install on each agent start. Identity records survive a
# workspace stop, including when the supervisor died but its runner did not.
set -euo pipefail

state_file="${state_file}"
supervisors="${module_directory}/supervisors"
workers="${module_directory}/workers"
cleanup_complete="${module_directory}/cleanup-complete"
rm -f "$cleanup_complete"
mkdir -p "$supervisors" "$workers" "$(dirname "$state_file")"
boot_id=$(< /proc/sys/kernel/random/boot_id)
[ -n "$boot_id" ] || { echo "Cannot read boot ID; refusing to start another runner" >&2; exit 1; }

# /proc stat starts with pid and (comm); starttime is field 20 after them.
process_identity() {
	local stat
	IFS= read -r stat <"/proc/$1/stat" 2>/dev/null || return 1
	stat=$${stat##*) }
	# shellcheck disable=SC2086 # Split /proc fields.
	set -- $stat
	[ "$1" != Z ] || return 1
	printf '%s' "$${20:-}"
}

# Records contain a pid, boot ID, and kernel process start time. A bare pid
# can name an unrelated process after a restart or PID reuse.
record_alive() {
	local recorded_boot recorded_start
	record_pid="" recorded_boot="" recorded_start=""
	read -r record_pid recorded_boot recorded_start <"$1" || true
	[[ "$record_pid" =~ ^[0-9]+$ && "$recorded_start" =~ ^[0-9]+$ ]] &&
		[ "$recorded_boot" = "$boot_id" ] &&
		[ "$(process_identity "$record_pid" || true)" = "$recorded_start" ]
}

# Delete before signalling and after everyone exits: a supervisor may still
# publish a terminal state while TERM is in flight.
rm -f "$state_file" "$state_file.tmp"

signal_records() {
	for record in "$supervisors"/* "$workers"/*; do
		[ -f "$record" ] || continue
		if record_alive "$record"; then kill "-$1" "$record_pid" 2>/dev/null || true; fi
	done
}

prune_records() {
	remaining=false
	for record in "$supervisors"/* "$workers"/*; do
		[ -f "$record" ] || continue
		if record_alive "$record"; then remaining=true; else rm -f "$record"; fi
	done
}

signal_records TERM
# Let supervisors stop their children gracefully, then force-stop only the
# processes whose identities still match. Do not start a new runner if either
# old process cannot be confirmed gone.
for ((i = 0; i < 100; i++)); do
	prune_records
	[ "$remaining" = true ] || break
	sleep 0.1
done
signal_records KILL
for ((i = 0; i < 50; i++)); do
	prune_records
	[ "$remaining" = true ] || break
	sleep 0.1
done
if [ "$remaining" = true ]; then
	rm -f "$state_file" "$state_file.tmp"
	echo "Previous Claude Code runner did not stop; refusing to start another" >&2
	exit 1
fi
rm -f "$state_file" "$state_file.tmp"
# A start script may have claimed the previous cleanup generation. Remove
# claims only after its processes are gone; the next start claims a new id.
for claim in "${module_directory}/started"/*; do
	if [ -d "$claim" ]; then rmdir "$claim"; fi
done
# A late wrapper from the old generation must exit before executing the CLI.
cat /proc/sys/kernel/random/uuid >"$cleanup_complete.tmp"
mv "$cleanup_complete.tmp" "$cleanup_complete"
