#!/usr/bin/env bash

set -euo pipefail

command_exists() {
  command -v "$1" > /dev/null 2>&1
}

ARG_PROVIDER=$(echo -n '${ARG_PROVIDER}' | base64 -d)
ARG_MODEL=$(echo -n '${ARG_MODEL}' | base64 -d)
ARG_GOOSE_CONFIG=$(echo -n '${ARG_GOOSE_CONFIG}' | base64 -d)
ARG_INSTALL='${ARG_INSTALL}'
ARG_GOOSE_VERSION=$(echo -n '${ARG_GOOSE_VERSION}' | base64 -d)
ARG_WORKDIR=$(echo -n '${ARG_WORKDIR}' | base64 -d)

echo "--------------------------------"
echo "provider: $${ARG_PROVIDER}"
echo "model: $${ARG_MODEL}"
echo "goose_config: $${ARG_GOOSE_CONFIG}"
echo "install: $${ARG_INSTALL}"
echo "goose_version: $${ARG_GOOSE_VERSION}"
echo "--------------------------------"

if [ "$${ARG_INSTALL}" = "true" ]; then
  echo "Installing Goose..."
  parsed_version="$${ARG_GOOSE_VERSION}"
  if [ "$${ARG_GOOSE_VERSION}" = "stable" ]; then
    parsed_version=""
  fi
  # The installer downloads the release archive into the current directory.
  (cd "$(mktemp -d)" && curl -fsSL https://github.com/aaif-goose/goose/releases/download/stable/download_cli.sh | GOOSE_VERSION="$${parsed_version}" CONFIGURE=false bash)
  echo "Goose installed"
else
  echo "Skipping Goose installation"
fi

if [ -n "$${ARG_GOOSE_CONFIG}" ]; then
  echo "Configuring Goose..."
  mkdir -p "$HOME/.config/goose"
  echo "GOOSE_PROVIDER: $${ARG_PROVIDER}" > "$HOME/.config/goose/config.yaml"
  echo "GOOSE_MODEL: $${ARG_MODEL}" >> "$HOME/.config/goose/config.yaml"
  echo "$${ARG_GOOSE_CONFIG}" >> "$HOME/.config/goose/config.yaml"
else
  echo "Skipping Goose configuration"
fi

if [ -n "$${GOOSE_SYSTEM_PROMPT:-}" ]; then
  echo "Setting Goose system prompt..."
  mkdir -p "$HOME/.config/goose"
  echo "$${GOOSE_SYSTEM_PROMPT}" > "$HOME/.config/goose/.goosehints"
else
  echo "Goose system prompt not set. use the GOOSE_SYSTEM_PROMPT environment variable to set it."
fi

if [ -n "$${ARG_WORKDIR}" ] && [ ! -d "$${ARG_WORKDIR}" ]; then
  echo "Creating workdir: $${ARG_WORKDIR}"
  mkdir -p "$${ARG_WORKDIR}"
fi

if command_exists goose; then
  GOOSE_CMD=$(command -v goose)
elif [ -f "$HOME/.local/bin/goose" ]; then
  GOOSE_CMD="$HOME/.local/bin/goose"
else
  echo "Error: Goose is not installed. Please enable install_goose or install it manually."
  exit 1
fi

# The module no longer launches Goose, so expose it on PATH for apps and scripts.
if [ -n "$${CODER_SCRIPT_BIN_DIR:-}" ] && [ ! -e "$${CODER_SCRIPT_BIN_DIR}/goose" ]; then
  ln -s "$${GOOSE_CMD}" "$${CODER_SCRIPT_BIN_DIR}/goose"
fi
