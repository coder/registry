#!/usr/bin/env bash
# Claude Code hook that reports Claude's state to a Coder app.
# Usage: report-status.sh <app-slug> <working|idle> [message]
#
# Coder treats a "working" report as workspace activity and extends the
# autostop deadline, so a workspace stays up while Claude works even with no
# IDE, SSH, or web terminal connection open.
#
# This hook must never block or fail Claude Code: it always exits 0 and sends
# the request in the background.

set -u

slug="$1"
state="$2"
message="$${3:-}"

# Drain the hook payload so Claude Code never blocks writing to stdin.
cat > /dev/null 2>&1 || true

if [ -z "$${CODER_AGENT_TOKEN:-}" ] || [ -z "$${CODER_AGENT_URL:-}" ]; then
  exit 0
fi

module_dir="$HOME/.coder-modules/coder/claude-code"
state_file="$${module_dir}/status/$${slug}"
mkdir -p "$${module_dir}/status" "$${module_dir}/logs" 2> /dev/null || exit 0

now=$(date +%s)
last_state=""
last_sent=0
if [ -f "$${state_file}" ]; then
  read -r last_state last_sent < "$${state_file}" 2> /dev/null || true
fi

# Tool hooks fire often. Resend "working" at most every 5 minutes, which is
# far below the smallest useful activity bump, and send other states only on
# change.
if [ "$${state}" = "$${last_state}" ]; then
  if [ "$${state}" != "working" ] || [ $((now - $${last_sent:-0})) -lt 300 ]; then
    exit 0
  fi
fi
printf '%s %s\n' "$${state}" "$${now}" > "$${state_file}"

payload=$(printf '{"app_slug":"%s","state":"%s","message":"%s"}' "$${slug}" "$${state}" "$${message}")
(
  curl --fail --silent --show-error --max-time 10 --output /dev/null \
    -X PATCH "$${CODER_AGENT_URL%/}/api/v2/workspaceagents/me/app-status" \
    -H "Coder-Session-Token: $${CODER_AGENT_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "$${payload}" \
    >> "$${module_dir}/logs/report-status.log" 2>&1
) < /dev/null &

exit 0
