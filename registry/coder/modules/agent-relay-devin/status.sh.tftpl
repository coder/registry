#!/usr/bin/env bash
# Rendered into the agent_relay_status agent metadata item (see README).
# Prints one line that Agent Relay reads to decide whether the
# workspace still has work:
#
#   pending          the start step has not written state yet
#   idle             no connect token for this agent start
#   working          remote alive, not connected to Devin's gateway yet
#   serving          remote alive and connected to Devin's gateway
#   orphaned         state says working but the process is gone
#   done <code>      remote exited with that status; 0 is the session's end
#   failed <reason>  the remote could not be started, or never connected
#
# working versus serving comes from matching serving_log_pattern against
# the remote log with ANSI escape sequences stripped, so the coloured
# connected line devin-remote prints still matches.
#
# Keep the vocabulary in sync with Agent Relay's reaper.
set -euo pipefail

state_file="${state_file}"
log_file="${log_file}"
# Free-form text, so it arrives base64-encoded and is matched as a fixed
# string: neither the shell nor grep interprets anything in it.
serving_log_pattern="$(echo -n '${serving_log_pattern}' | base64 -d)"
esc="$(printf '\033')"

# True when the pid is alive and is our remote. kill -0 alone would
# trust a reused pid; the cmdline check ties it to the binary we launched.
remote_alive() {
	[ -n "$${1:-}" ] && kill -0 "$1" 2>/dev/null &&
		tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -qF -- "${remote_name}"
}

# True once the remote's log holds serving_log_pattern. grep -q stops
# reading early, so pipefail is off here to ignore sed's SIGPIPE.
connected() {
	local -
	set +o pipefail
	[ -f "$log_file" ] && sed "s/$esc\[[0-9;]*[A-Za-z]//g" "$log_file" 2>/dev/null | grep -qF -- "$serving_log_pattern"
}

# The state file can vanish between any check and the read, when a
# cleanup runs, so a missing or empty file reads as pending.
state=""
detail=""
{ read -r state detail <"$state_file"; } 2>/dev/null || true
if [ -z "$state" ]; then
	echo "pending"
	exit 0
fi

case "$state" in
working)
	if ! remote_alive "$${detail:-}"; then
		# The remote vanished without the supervisor recording an
		# exit, e.g. an OOM kill, or the pid now belongs to something
		# else. Distinct from done so Agent Relay can grade the failure.
		echo "orphaned"
		exit 0
	fi
	if connected; then
		echo "serving"
	else
		echo "working"
	fi
	;;
done)
	echo "done $${detail:-0}"
	;;
failed)
	echo "failed $${detail:-unknown}"
	;;
*)
	echo "$state"
	;;
esac
