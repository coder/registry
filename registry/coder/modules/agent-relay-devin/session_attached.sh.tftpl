#!/usr/bin/env bash
# Rendered into the agent_relay_session_attached agent metadata item (see
# README). Prints one line that Agent Relay reads to decide whether to keep
# the workspace's autostop deadline moving:
#
#   attached  the remote is running, so the Devin session is live here
#   stopped   the remote is not running: it exited, died, never started,
#             or the workspace was created manually
#
# devin-remote serves exactly one session for its whole life and has no
# management server, so a running remote is an attached session.
#
# Running means the pid the supervisor recorded is alive and is still the
# binary it launched. The supervisor writes "working <pid>" after it starts
# the remote and replaces it with "done <code>" or "failed <reason>" when
# the remote exits or is given up on.
set -euo pipefail

state_file="${state_file}"

# True when the pid is alive and is our remote. kill -0 alone would
# trust a reused pid; the cmdline check ties it to the binary we launched.
remote_alive() {
	[ -n "$${1:-}" ] && kill -0 "$1" 2>/dev/null &&
		tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null | grep -qF -- "${remote_name}"
}

state=""
detail=""
{ read -r state detail <"$state_file"; } 2>/dev/null || true
if [ "$state" = "working" ] && remote_alive "$detail"; then
	echo "attached"
else
	echo "stopped"
fi
