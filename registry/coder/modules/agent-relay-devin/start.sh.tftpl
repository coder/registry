#!/usr/bin/env bash
# Start step, run by coder-utils after the install step. Runs at agent
# start with AGENT_RELAY_DEVIN_TOKEN (the connect token Devin returned with
# Agent Relay's claim, which the agent injects from the workspace secret),
# AGENT_RELAY_SESSION_ID, AGENT_RELAY_DEVIN_GATEWAY_URL, and
# AGENT_RELAY_DEVIN_SESSION_KIND in scope.
#
# Starts `devin-remote serve` detached and exits, so the agent reaches the
# ready lifecycle state instead of sitting in starting for the life of the
# session. The detached supervisor records the remote's lifecycle to
# ${state_file}, which the agent_relay_status agent metadata item publishes
# for Agent Relay. See README.
set -euo pipefail

# Pre-install cleanup normally publishes a fresh generation after attempting
# to stop old remotes. If cleanup did not run, the marker may be absent or
# still have a claim from the prior start. Rotate it so the old supervisor
# cannot change this start's state; an old remote may remain alive.
cleanup_marker="${module_directory}/cleanup-complete"
mkdir -p "${module_directory}"
new_generation() {
	cleanup_id="$(cat /proc/sys/kernel/random/uuid 2>/dev/null || printf '%s-%s' "$$" "$RANDOM")"
	printf '%s\n' "$cleanup_id" >"$cleanup_marker.tmp"
	mv "$cleanup_marker.tmp" "$cleanup_marker"
}
cleanup_id="$(cat "$cleanup_marker" 2>/dev/null || true)"
if [[ ! "$cleanup_id" =~ ^[0-9a-f-]+$ ]]; then
	echo "Pre-install cleanup did not publish a marker; starting a remote anyway." >&2
	new_generation
elif [ -d "${module_directory}/started/$cleanup_id" ]; then
	echo "Previous Devin start still claims this generation; starting a new generation anyway." >&2
	new_generation
fi

state_file="${state_file}"
log_file="${log_file}"
# The connect token is staged in a fresh 0700 directory per start on
# non-persistent storage (XDG_RUNTIME_DIR, else /tmp), never under $HOME,
# which is often a volume that survives a workspace stop. The remote
# deletes the token as soon as it has read it, the supervisor removes the
# directory when it exits, and cleanup removes any a killed run left.
runtime_prefix="agent-relay-devin-$UID."
remove_runtime_dirs() {
	local dir
	for dir in "$${XDG_RUNTIME_DIR:-/tmp}/$runtime_prefix"* "/tmp/$runtime_prefix"*; do
		if [ -d "$dir" ] && [ ! -L "$dir" ] && [ -O "$dir" ]; then
			rm -rf "$dir" || echo "Cannot remove $dir" >&2
		fi
	done
}
# Runtime-materialized scripts live under the module directory's
# scripts/ regardless of where state_file points, so an override of
# state_file moves only the state.
scripts_dir="${module_directory}/scripts"
# One identity record per live supervisor and per live remote, read by
# cleanup.sh.
supervisors="${module_directory}/supervisors"
remotes="${module_directory}/remotes"
workdir="${workdir}"
state_dir="${state_dir}"
mkdir -p "$scripts_dir" "$supervisors" "$remotes" "$(dirname "$state_file")" "$(dirname "$log_file")"

write_state() {
	# Write via a temp file so a reader never sees a partial line.
	printf '%s\n' "$1" >"$state_file.tmp"
	mv "$state_file.tmp" "$state_file"
}

if [ -z "$${AGENT_RELAY_DEVIN_TOKEN:-}" ]; then
	# No credential for this agent start: a manual workspace, or a restart
	# after the ephemeral credential was cleared. No remote can run either
	# way; whatever a previous run recorded no longer applies.
	# A skipped cleanup may have left the previous session's token.
	remove_runtime_dirs
	write_state "idle"
	echo "No Devin connect token in this build. Agent Relay delivers one only on the build it dispatches."
	echo "Idling. If Agent Relay did not create this workspace, delete it."
	exit 0
fi

# A claim prevents concurrent starts for this generation. A later start
# rotates a still-claimed generation rather than blocking on stale state.
mkdir -p "${module_directory}/started"
if ! mkdir "${module_directory}/started/$cleanup_id" 2>/dev/null; then
	echo "Remote already started for this cleanup generation" >&2
	exit 1
fi
write_state "pending"

# The session id names a state directory and a stamp file, so it must be a
# single safe path component. Problems with what Agent Relay stamped are
# reported as a terminal state rather than started blind.
session_id="$${AGENT_RELAY_SESSION_ID:-}"
if [[ ! "$session_id" =~ ^[A-Za-z0-9._-]+$ ]] || [ "$session_id" = "." ] || [ "$session_id" = ".." ]; then
	write_state "failed invalid-session"
	echo "agent_relay_session_id is empty or not a safe path component; cannot start devin-remote." >&2
	exit 1
fi
if [ -z "$${AGENT_RELAY_DEVIN_GATEWAY_URL:-}" ]; then
	write_state "failed invalid-session"
	echo "agent_relay_devin_gateway_url is empty; cannot start devin-remote." >&2
	exit 1
fi

# A missing or unverified binary is reported as a terminal state for Agent
# Relay to observe rather than started blind, which would loop as
# "done 127".
%{ if remote_binary != "" ~}
if ! binary="$(command -v ${remote_binary})" || [[ "$binary" != /* ]]; then
	write_state "failed remote-binary-missing"
	echo "The remote binary '${remote_binary}' is not available." >&2
	echo "Bake devin-remote into the image at that path, or unset remote_binary to download it. See the module README." >&2
	exit 1
fi
%{ else ~}
# Written by the install step: "ok <path>" or "failed <reason>".
install_result="${module_directory}/install-result"
result=""
binary=""
if [ -f "$install_result" ]; then
	read -r result binary <"$install_result" || true
fi
case "$result" in
ok) ;;
failed)
	write_state "failed $${binary:-download}"
	echo "The install step could not provide devin-remote ($${binary:-download}); see ${module_directory}/logs/install.log." >&2
	exit 1
	;;
*)
	write_state "failed remote-binary-missing"
	echo "The install step recorded no devin-remote binary; see ${module_directory}/logs/install.log." >&2
	exit 1
	;;
esac
if [ ! -x "$binary" ]; then
	write_state "failed remote-binary-missing"
	echo "The verified devin-remote at $binary is gone." >&2
	exit 1
fi
%{ endif ~}

mkdir -p "$workdir" "$state_dir/$session_id"

# Devin writes a stamp in each directory and warns the user on resume if
# one is missing. A missing stamp here means the volume that survives a
# workspace stop does not cover that path, which is a template problem
# rather than a Devin one. The remote still starts.
if [ "$${AGENT_RELAY_DEVIN_SESSION_KIND:-}" = "resume" ]; then
	for stamp in "$workdir/.devin-outpost-stamps/$session_id" "$state_dir/$session_id/outpost_stamp"; do
		if [ ! -e "$stamp" ]; then
			echo "Warning: resuming Devin session $session_id, but its stamp $stamp is missing. The workspace's persistent storage may not cover this path; Devin will warn the user that the environment changed." >&2
		fi
	done
fi

# Written owner-only before the supervisor starts, so the remote never
# reads a partial token. The remote reads it into its own environment,
# which Devin's spawn contract requires.
runtime_base="$${XDG_RUNTIME_DIR:-/tmp}"
if [ ! -d "$runtime_base" ] || [ ! -w "$runtime_base" ]; then
	runtime_base="/tmp"
fi
if ! run_dir="$(mktemp -d "$runtime_base/$${runtime_prefix}XXXXXXXX")" ||
	! chmod 700 "$run_dir" ||
	! (
		umask 077
		printf '%s' "$AGENT_RELAY_DEVIN_TOKEN" >"$run_dir/token"
	); then
	[ -z "$${run_dir:-}" ] || rm -rf "$run_dir"
	write_state "failed launch"
	echo "Cannot stage the connect token under $runtime_base; not starting devin-remote." >&2
	exit 1
fi

# The supervisor outlives this script: it owns the remote process and is
# the only writer of terminal state. Written to disk rather than inlined so
# setsid gets a clean argv. The session id and gateway URL are read from
# the supervisor's environment at run time, escaped here so they are never
# rendered into the file. Parameter values are user input; interpolating
# them into the file would let shell metacharacters run as code.
#
# The remote runs with a clean environment: only the variables in
# remote_env_names, plus Devin's own. Nothing else the agent or other
# modules export reaches it or the commands Devin runs, including
# CODER_AGENT_TOKEN and AGENT_RELAY_DEVIN_TOKEN. Just before the exec the
# remote lists the environment a child really receives, which includes
# entries bash cannot name, and drops anything else with env -u (names
# only on argv). Without compgen, or without a usable env -0, it refuses
# to start. The connect token is passed as DEVIN_OUTPOST_CONNECT_TOKEN
# because Devin's spawn contract requires it; it is exported in the
# remote's own process, so its value never appears on a command line.
# The supervisor itself is started without AGENT_RELAY_DEVIN_TOKEN in its
# environment, so only the remote's /proc environ holds the token.
#
# A remote that gives up before exec (identity, workdir, token, or
# environment) flags it in the runtime directory, and the supervisor
# reports failed launch rather than done.
#
# devin-remote exits 0 when its session suspends or terminates. That is
# the end of the session, never a crash, and it is not restarted.
#
# The supervisor publishes its identity (pid, boot id, /proc starttime)
# under supervisors/ before it launches anything, and the remote publishes
# its own under remotes/ before it execs devin-remote, which keeps the pid
# and starttime. cleanup.sh can then stop both on the next start without
# trusting a reused pid, even when the supervisor was SIGKILLed and the
# remote outlived it. Either process exits without running anything if it
# cannot publish, or if a newer cleanup has started, so no remote runs
# untracked. On TERM the supervisor stops the remote and exits without
# writing a terminal state: the remote was stopped, it did not finish.
#
# A watchdog gives the remote ${connect_timeout} seconds to log
# serving_log_pattern. Past that, it signals the supervisor, which records
# failed connect-timeout, stops the remote, and does not overwrite that
# state when the remote exits. The log is truncated before the remote is
# forked, so the watchdog never sees a previous run's connected line.
#
# The cleanup id, the binary, and the runtime directory reach the
# supervisor only as arguments.
# The script file holds nothing specific to this start, so a late start
# from before a newer cleanup that runs a newer start's script still checks
# its own, stale id. The file is replaced by rename, so a running
# supervisor keeps reading the copy it started with.
supervisor="$scripts_dir/supervise.sh"
cat >"$supervisor.$$.tmp" <<SUPERVISOR
#!/usr/bin/env bash
set -uo pipefail

# The id of the cleanup this run's start step followed.
cleanup_id="\$${1:-}"
[ -n "\$cleanup_id" ] || exit 1
# The verified devin-remote binary to run.
binary="\$${2:-}"
[ -n "\$binary" ] || exit 1
# This start's 0700 runtime directory, holding the staged token until the
# remote reads it, and the launch-failed flag.
run_dir="\$${3:-}"
[ -n "\$run_dir" ] || exit 1
token_file="\$run_dir/token"
launch_failed_flag="\$run_dir/launch-failed"

boot_id="\$(cat /proc/sys/kernel/random/boot_id)" || exit 1

# Prints the /proc starttime of pid. comm, field 2, may contain spaces and
# parentheses; after the last ") " starttime, field 22, is field 20.
starttime_of() {
	local stat
	stat="\$(cat "/proc/\$1/stat" 2>/dev/null)" || return 1
	stat="\$${stat##*) }"
	# shellcheck disable=SC2086 # Word splitting into fields is the point.
	set -- \$stat
	printf '%s' "\$${20:-}"
}

# True while the marker still holds this run's cleanup id, that is, while
# no newer cleanup has started. Shared state (the state file, the token)
# belongs to whichever run that is, so this run only touches it while
# current.
current() {
	[ "\$(cat "$cleanup_marker" 2>/dev/null)" = "\$cleanup_id" ]
}

# Publishes the calling process's identity as <dir>/<pid>.<starttime>,
# renamed into place so cleanup.sh never reads a partial record. Then
# confirms the run is still current: a cleanup removes the marker before
# it reads any record, so once the check passes, every later cleanup sees
# the record.
publish() {
	local pid="\$1" dir="\$2" start
	start="\$(starttime_of "\$pid")" && [ -n "\$start" ] || return 1
	if ! { printf '%s %s %s\n' "\$pid" "\$boot_id" "\$start" >"\$dir/.\$pid.tmp" &&
		mv "\$dir/.\$pid.tmp" "\$dir/\$pid.\$start"; }; then
		rm -f "\$dir/.\$pid.tmp"
		return 1
	fi
	if ! current; then
		rm -f "\$dir/\$pid.\$start"
		return 1
	fi
}

# True once the remote's log, with ANSI escape sequences stripped, holds
# serving_log_pattern as a fixed string.
esc="\$(printf '\033')"
serving_log_pattern="\$(echo -n '${serving_log_pattern}' | base64 -d)"
connected() {
	local -
	set +o pipefail
	[ -f "$log_file" ] && sed "s/\$esc\[[0-9;]*[A-Za-z]//g" "$log_file" 2>/dev/null | grep -qF -- "\$serving_log_pattern"
}

record="$supervisors/\$\$.\$(starttime_of \$\$)"
on_exit() {
	# The claim's token is no use to anyone once the remote is gone; this
	# start's runtime directory is never shared, so it is always removed.
	rm -rf "\$run_dir"
	rm -f "$supervisors/.\$\$.tmp" "\$record"
}
trap on_exit EXIT

remote_pid=""
watchdog_pid=""
# Set once the watchdog gives up on the connection, so the exit that
# follows does not replace failed connect-timeout with done.
timed_out=0
timeout_signals=0

# Stops the watchdog, so it cannot report a timeout for a remote that is
# being stopped.
stop_watchdog() {
	trap '' USR1
	if [ -n "\$watchdog_pid" ]; then
		kill -TERM "\$watchdog_pid" 2>/dev/null
		wait "\$watchdog_pid" 2>/dev/null
	fi
}

# Stops the remote and removes its record once wait confirms it is gone.
# \$! is the remote once it is launched, even if TERM lands before its pid
# is saved; the watchdog starts only after remote_pid is set.
stop() {
	local remote="\$${remote_pid:-\$${!:-}}" start
	stop_watchdog
	if [ -n "\$remote" ]; then
		# An unreaped child keeps its /proc entry, so this cannot miss.
		start="\$(starttime_of "\$remote" || true)"
		kill -TERM "\$remote" 2>/dev/null
		wait "\$remote" 2>/dev/null
		[ -z "\$start" ] || rm -f "$remotes/\$remote.\$start"
	fi
	exit 0
}
trap stop TERM

# The watchdog's first signal stops the remote; a second, sent when the
# remote ignores TERM, kills it. The remote is an unreaped child until the
# wait loop below ends, so its pid cannot have been reused.
on_connect_timeout() {
	[ -n "\$remote_pid" ] || return 0
	timeout_signals=\$((timeout_signals + 1))
	if [ "\$timeout_signals" -eq 1 ]; then
		timed_out=1
		write_state "failed connect-timeout"
		kill -TERM "\$remote_pid" 2>/dev/null
	else
		kill -KILL "\$remote_pid" 2>/dev/null
	fi
}
trap on_connect_timeout USR1

publish "\$\$" "$supervisors" || exit 1

write_state() {
	current || return 0
	printf '%s\n' "\$1" >"$state_file.tmp"
	mv "$state_file.tmp" "$state_file"
}

unset AGENT_RELAY_DEVIN_TOKEN
# The remote publishes itself from the subshell, clears its environment,
# then execs devin-remote, which keeps the pid. Keep remote_env_names in
# sync with the README. The log is truncated here, before the fork, so the
# watchdog cannot match a previous run's connected line.
: >"$log_file"
(
	# Gives up before devin-remote runs. The flag makes the supervisor
	# report failed launch instead of done.
	launch_failed() {
		echo "Not starting devin-remote: \$1" >&2
		: >"\$launch_failed_flag"
		exit 1
	}
	publish "\$BASHPID" "$remotes" || launch_failed "cannot record its identity, or a newer start took over"
	cd "$workdir" || launch_failed "cannot enter $workdir"
	token="\$(cat "\$token_file")" || launch_failed "cannot read the staged connect token"
	rm -f "\$token_file"
	# The environment can only be cleared with compgen, which a minimal
	# bash may lack. Without it nothing would be unset.
	[ "\$(type -t compgen)" = "builtin" ] || launch_failed "this bash has no compgen builtin, so the environment cannot be cleared"
	session_id="\$AGENT_RELAY_SESSION_ID"
	gateway_url="\$AGENT_RELAY_DEVIN_GATEWAY_URL"
	remote_env_names="PATH HOME USER LOGNAME TMPDIR LANG TZ DISPLAY WAYLAND_DISPLAY XAUTHORITY"
	devin_env_names="DEVIN_OUTPOST_GATEWAY_URL DEVIN_OUTPOST_CONNECT_TOKEN DEVIN_OUTPOST_SESSION_ID DEVIN_REMOTE_STATE_DIR%{ if chrome_path != "" } DEVIN_CHROME_PATH%{ endif }%{ if desktop } DEVIN_OUTPOST_DESKTOP%{ endif }"
	kept=()
	for name in \$remote_env_names; do
		[ -z "\$${!name+set}" ] || kept+=("\$name=\$${!name}")
	done
	for name in \$(compgen -e); do
		unset "\$name" 2>/dev/null
	done
	# Exported shell functions travel in the environment too.
	while read -r _ _ name; do
		[ -z "\$name" ] || unset -f "\$name"
	done <<<"\$(declare -Fx)"
	for assignment in "\$${kept[@]+"\$${kept[@]}"}"; do
		# shellcheck disable=SC2163 # Each element is NAME=value.
		export "\$assignment"
	done
	export DEVIN_OUTPOST_GATEWAY_URL="\$gateway_url"
	export DEVIN_OUTPOST_CONNECT_TOKEN="\$token"
	export DEVIN_OUTPOST_SESSION_ID="\$session_id"
	export DEVIN_REMOTE_STATE_DIR="$state_dir/\$session_id"
%{ if chrome_path != "" ~}
	export DEVIN_CHROME_PATH="${chrome_path}"
%{ endif ~}
%{ if desktop ~}
	export DEVIN_OUTPOST_DESKTOP=true
%{ endif ~}
	unset token
	# compgen only sees what bash holds as variables. The environment a
	# child receives can also carry entries bash cannot name (bad-name=x,
	# 1X=y, BASH_FUNC_f()=) and readonly variables, so list it for real.
	# _ is the command path bash adds for env itself, not for the exec.
	allowed() {
		local n
		for n in \$remote_env_names \$devin_env_names _; do
			[ "\$1" != "\$n" ] || return 0
		done
		return 1
	}
	shopt -s lastpipe
	strays=()
	env -0 | while IFS= read -r -d '' entry; do
		name="\$${entry%%=*}"
		[ -n "\$name" ] || launch_failed "its environment has an entry with no name"
		allowed "\$name" || strays+=("\$name")
	done
	[ "\$${PIPESTATUS[0]}" -eq 0 ] || launch_failed "env -0 cannot list its environment"
	unset entry
	# A failed exec reports failed launch rather than exiting 126 or 127.
	shopt -s execfail
	if [ "\$${#strays[@]}" -eq 0 ]; then
		exec "\$binary" serve
	else
		# env -u takes names only, never values, so nothing secret reaches
		# a command line.
		echo "Dropping \$${#strays[@]} environment entries bash cannot clear." >&2
		drop=()
		for name in "\$${strays[@]}"; do
			drop+=(-u "\$name")
		done
		exec env "\$${drop[@]}" "\$binary" serve
	fi
	launch_failed "cannot run \$binary"
) >"$log_file" 2>&1 &
remote_pid=\$!
remote_start="\$(starttime_of "\$remote_pid" || true)"
write_state "working \$remote_pid"

# Gives up on the connection once ${connect_timeout} seconds pass without
# serving_log_pattern in the log. It stops early when the remote exits or
# the generation changes, and checks the supervisor's own identity before
# each signal, so an orphaned watchdog never signals a reused pid.
(
	supervisor_start="\$(starttime_of \$\$)"
	alive() {
		[ "\$(starttime_of "\$1" || true)" = "\$2" ]
	}
	deadline=\$((SECONDS + ${connect_timeout}))
	while [ "\$SECONDS" -lt "\$deadline" ]; do
		current && alive \$\$ "\$supervisor_start" && alive "\$remote_pid" "\$remote_start" || exit 0
		! connected || exit 0
		sleep 1
	done
	! connected || exit 0
	current && alive \$\$ "\$supervisor_start" || exit 0
	kill -USR1 \$\$ 2>/dev/null || exit 0
	for ((i = 0; i < 10; i++)); do
		sleep 1
		alive "\$remote_pid" "\$remote_start" || exit 0
	done
	alive \$\$ "\$supervisor_start" || exit 0
	kill -USR1 \$\$ 2>/dev/null
	exit 0
) </dev/null >/dev/null 2>&1 &
watchdog_pid=\$!

# A trapped USR1 interrupts wait with a status above 128 while the remote
# is still running; keep waiting until it has exited.
while :; do
	wait "\$remote_pid"
	code=\$?
	if [ "\$code" -gt 128 ] && kill -0 "\$remote_pid" 2>/dev/null; then
		continue
	fi
	break
done
stop_watchdog
[ -z "\$remote_start" ] || rm -f "$remotes/\$remote_pid.\$remote_start"
if [ -e "\$launch_failed_flag" ]; then
	write_state "failed launch"
elif [ "\$timed_out" -eq 0 ]; then
	write_state "done \$code"
fi
SUPERVISOR
chmod +x "$supervisor.$$.tmp"
mv "$supervisor.$$.tmp" "$supervisor"

echo "Starting Devin remote (detached)..."
# The supervisor starts without the connect token in its environment, so
# its /proc environ does not hold it for the life of the session. Only the
# variable's name is on the command line.
env -u AGENT_RELAY_DEVIN_TOKEN setsid nohup "$supervisor" "$cleanup_id" "$binary" "$run_dir" >/dev/null 2>&1 </dev/null &

# Give the supervisor a moment to record state, so a workspace that
# fails immediately is visible as such rather than as pending, and so
# this step returns with the supervisor's identity record in place. Not a
# readiness gate: the remote connecting to Devin happens later, and
# blocking on it would keep the agent out of the ready state.
state=""
for ((i = 0; i < 50; i++)); do
	state="$(cat "$state_file" 2>/dev/null || true)"
	case "$state" in "" | pending) sleep 0.2 ;; *) break ;; esac
done

case "$state" in
"" | pending) echo "Remote did not report state within 10s; check $log_file" >&2 ;;
*) echo "Remote state: $state" ;;
esac
echo "Remote log: $log_file"
